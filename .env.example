MYSQL_ROOT_PASSWORD=devroot
MYSQL_DATABASE=financetracker
MYSQL_USER=fin_user
MYSQL_PASSWORD=fin_pass

DB_HOST=db
DB_PORT=3306
DB_NAME=financetracker
DB_USER=fin_user
DB_PASSWORD=fin_pass

CORS_ORIGINS=http://localhost:5173
VITE_API_URL=/api

# Use a long random value outside development. Production refuses to boot without it.
APP_ENV=development
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_DAYS=7

# Per-process/IP abuse protection. For multiple API replicas, use a shared-store limiter.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
REGISTER_RATE_LIMIT_REQUESTS=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_REQUESTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Only list reverse proxies you control. CIDR notation is accepted.
TRUSTED_PROXY_IPS=
